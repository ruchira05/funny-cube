                <mxCell id="c1443" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aab7b8;strokeWidth=0.8;fontSize=10;fontColor=#1a1a1a;align=center;verticalAlign=middle;arcSize=3;" value="TP2" vertex="1">
