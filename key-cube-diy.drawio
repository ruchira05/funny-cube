        <mxCell id="listc1" value="KEY CUBE  ·  DIY BUILD  ·  COMPONENT LIST" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A1A1A;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1090" height="30" as="geometry" /></mxCell>
        <mxCell id="listc2" value="Hand-built box instead of a 3D print. Outside 46 × 46 × 96 mm, 2 mm sheet walls, inside 42 × 42 × 92 mm. Bigger than v3 to fit the 40 mm speaker, which sits in the back lid.&lt;br&gt;All codes are tronic.lk part numbers. Page 2 draws each module, page 3 each panel to cut, page 4 the inside layout, page 5 the open test frame, page 6 the main board wiring. Click a blue code to open its tronic.lk page (in the draw.io editor: Ctrl/Cmd-click, or the link icon)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1090" height="36" as="geometry" /></mxCell>
