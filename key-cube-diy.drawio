        <mxCell id="mainboardc218" value="GND bus" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAAAAA;strokeWidth=1;fontSize=8;fontColor=#1A1A1A;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="914" y="616" width="74" height="18" as="geometry" /></mxCell>
        <mxCell id="mainboardc219" value="J1-22 (GND)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAAAAA;strokeWidth=1;fontSize=8;fontColor=#1A1A1A;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="988" y="616" width="112" height="18" as="geometry" /></mxCell>
        <mxCell id="mainboardc220" value="black" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAAAAA;strokeWidth=1;fontSize=8;fontColor=#1A1A1A;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1100" y="616" width="64" height="18" as="geometry" /></mxCell>
        <mxCell id="mainboardc221" value="&lt;b&gt;Not on MB:&lt;/b&gt; LiPo JST → charger B+ / B−. Charger OUT+ / OUT− → boost IN+ / GND (short red / black). Amp screw terminal → speaker lugs (10 cm, so the lid can come off).&lt;br&gt;Only 3 wire colours are in stock today, so wrap a band of tape on every 5 V wire to tell it from 3V3." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="690" y="642" width="470" height="70" as="geometry" /></mxCell>
        <mxCell id="mainboardc222" value="HOW TO MAKE A MODULE PLUG (OLED, MIC)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="618" width="500" height="14" as="geometry" /></mxCell>
