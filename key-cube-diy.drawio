        <mxCell id="panelsc82" value="P6  Left side" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1A1A1A;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="792" width="300" height="14" as="geometry" /></mxCell>
