        <mxCell id="panelsc84" value="35" style="html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48" y="820" as="sourcePoint" /><mxPoint x="48" y="957.8" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="panelsc85" value="plain, no holes" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=8;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="871.18" width="303.15" height="12" as="geometry" /></mxCell>
        <mxCell id="panelsc86" value="P7  Lid screw block × 2" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1A1A1A;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="792" width="300" height="14" as="geometry" /></mxCell>
