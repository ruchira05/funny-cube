        <mxCell id="mainboardc254" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;dashed=1;" vertex="1" parent="1"><mxGeometry x="117.7" y="869.1" width="124.6" height="135.8" as="geometry" /></mxCell>
        <mxCell id="mainboardc255" value="7-pin female socket along one edge,&lt;br&gt;amp outline dashed.&lt;br&gt;Wire the socket pins to MB as C3&lt;br&gt;(GAIN left open).&lt;br&gt;&lt;br&gt;Final box: two 5 mm standoffs (TA1037)&lt;br&gt;hot-glued under the top panel,&lt;br&gt;M3 × 6 nylon bolts (TA1045).&lt;br&gt;Test frame: tie under T2." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="860" width="300" height="154" as="geometry" /></mxCell>
