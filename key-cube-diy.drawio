        <mxCell id="panelsc134" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E6CF;strokeColor=#8A6A3B;strokeWidth=1.5;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="23.62" height="23.62" as="geometry" /></mxCell>
        <mxCell id="panelsc135" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="65.51" y="875.51" width="12.6" height="12.6" as="geometry" /></mxCell>
        <mxCell id="panelsc136" value="end" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=7;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="897.62" width="44" height="10" as="geometry" /></mxCell>
        <mxCell id="panelsc137" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E6CF;strokeColor=#8A6A3B;strokeWidth=1.5;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="104" y="870" width="31.5" height="23.62" as="geometry" /></mxCell>
        <mxCell id="panelsc138" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8CCD0;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="135.5" y="872.36" width="9.45" height="18.9" as="geometry" /></mxCell>
        <mxCell id="panelsc139" value="side + nut" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=7;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="897.62" width="47.24" height="10" as="geometry" /></mxCell>
        <mxCell id="panelsc140" value="8" style="html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="104" y="862" as="sourcePoint" /><mxPoint x="135.5" y="862" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="panelsc141" value="6" style="html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="48" y="870" as="sourcePoint" /><mxPoint x="48" y="893.62" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="panelsc142" value="Glue four 6 × 6 squares of acrylic offcut into a stack, drill Ø3.2 through, glue an M3 nut (TA1608) on the inner end. Glue each block into a back top corner, flush with the box end, so the hole lines up with the lid hole at (5, 5) / (41, 5). Lid screws: M3 × 12 countersunk (TA1261)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="190" y="866" width="560" height="50" as="geometry" /></mxCell>
        <mxCell id="panelsc143" value="&lt;b&gt;HOW THE PANELS FIT&lt;/b&gt;&lt;br&gt;• P3 top and P4 bottom are full width (46). P5 / P6 sides sit between them (42 + 2 + 2 = 46).&lt;br&gt;• All four long panels are 92 long. P1 front glues over one end, P2 lid screws over the other (2 + 92 + 2 = 96).&lt;br&gt;• Inside space is 42 × 42 × 92 mm. Page 4 shows where each part sits.&lt;br&gt;• Sand the edges square, dry-fit with tape, then glue: bottom + sides, then front, then top. Fit the electronics before gluing the top on.&lt;br&gt;• Drill small holes (Ø1.5 / Ø2) before cutting the panel out, so it is easier to hold.&lt;br&gt;• Glue the speaker rim to the inside of P2 with super glue (TA0165) or hot glue, centred on the grille. Leave about 10 cm of speaker wire so the lid can come off." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="770" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
