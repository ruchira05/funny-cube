        <mxCell id="panelsc89" value="end" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=7;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="843.69" width="40" height="10" as="geometry" /></mxCell>
        <mxCell id="panelsc90" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E6CF;strokeColor=#8A6A3B;strokeWidth=1.5;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="820" width="39.37" height="19.69" as="geometry" /></mxCell>
        <mxCell id="panelsc91" value="side" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=7;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="843.69" width="39.37" height="10" as="geometry" /></mxCell>
        <mxCell id="panelsc92" value="10" style="html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="812" as="sourcePoint" /><mxPoint x="549.37" y="812" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="panelsc93" value="5" style="html=1;rounded=0;strokeColor=#555555;strokeWidth=1;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458" y="820" as="sourcePoint" /><mxPoint x="458" y="839.69" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="panelsc94" value="Pilot hole Ø1.6 for M2 × 6. Glue each block into a&lt;br&gt;back top corner, flush with the box end, so the hole&lt;br&gt;lines up with the lid hole at (4.5, 4.5) / (36.5, 4.5)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="860" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="panelsc95" value="&lt;b&gt;HOW THE PANELS FIT&lt;/b&gt;&lt;br&gt;• P3 top and P4 bottom are full width (41). P5 / P6 sides sit between them (35 + 2 + 2 = 39).&lt;br&gt;• All four long panels are 77 long. P1 front glues over one end, P2 lid screws over the other (2 + 77 + 2 = 81).&lt;br&gt;• Inside space is 37 × 35 × 77 mm, the same as the v3 print.&lt;br&gt;• Sand the edges square, dry-fit with tape, then glue: bottom + sides, then top, then front. Fit the electronics before gluing the top on.&lt;br&gt;• Drill small holes (Ø1.5 / Ø2) before cutting the panel out, so it is easier to hold." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="770" height="150" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
