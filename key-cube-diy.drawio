        <mxCell id="mainboardc224" value="" style="html=1;rounded=0;strokeColor=#1A1A1A;strokeWidth=2;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78.89" y="675.7" as="sourcePoint" /><mxPoint x="108.89" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="mainboardc225" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="87.78" y="640" width="17.78" height="35.7" as="geometry" /></mxCell>
        <mxCell id="mainboardc226" value="" style="html=1;rounded=0;strokeColor=#D12C2C;strokeWidth=2;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.67" y="675.7" as="sourcePoint" /><mxPoint x="126.67" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="mainboardc227" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="105.56" y="640" width="17.78" height="35.7" as="geometry" /></mxCell>
        <mxCell id="mainboardc228" value="" style="html=1;rounded=0;strokeColor=#2F9E44;strokeWidth=2;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="114.45" y="675.7" as="sourcePoint" /><mxPoint x="144.45" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="mainboardc229" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2B2B2B;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="123.34" y="640" width="17.78" height="35.7" as="geometry" /></mxCell>
        <mxCell id="mainboardc230" value="" style="html=1;rounded=0;strokeColor=#2F9E44;strokeWidth=2;fontSize=9;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132.23" y="675.7" as="sourcePoint" /><mxPoint x="162.23" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="mainboardc231" value="1. Cut a piece of female header (HE0005) with as many pins as the module: cut through the next pin, it is lost.&lt;br&gt;2. Slide 2 mm heat-shrink on each wire, solder it to a pin tail, shrink it.&lt;br&gt;3. Put a strip of tape around the plug and write the module name and pin 1 on it.&lt;br&gt;4. Solder the other end of each wire to MB as in the table. Keep I2C and touch wires short and away from the antenna end." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="180" y="636" width="450" height="110" as="geometry" /></mxCell>
        <mxCell id="mainboardc232" value="SOCKET CARRIERS  ·  small Vero pieces from the 6th dot board, drawn like MB (component side)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="1000" height="16" as="geometry" /></mxCell>
