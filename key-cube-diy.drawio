        <mxCell id="listc214" value="Inside the back-lid grille" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;align=left;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="576" y="954" width="250" height="22" as="geometry" /></mxCell>
        <mxCell id="listc215" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=10;fontColor=#1A1A1A;align=left;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="826" y="954" width="284" height="22" as="geometry" /></mxCell>
        <mxCell id="listc216" value="Tools: craft knife and steel ruler, Ø1.5 / Ø2 drills (pin vise is fine), fine file, soldering iron, multimeter.&lt;br&gt;⚠ Boost board ships at 12 V: open pads A and B for 5 V and measure before connecting. ⚠ Check the LiPo plug polarity with a multimeter. ⚠ Charge through the charger port only; flash through the DevKit USB with the lid off, not while charging." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1090" height="70" as="geometry" /></mxCell>
      </root>
