        <mxCell id="panelsc79" value="← FRONT" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=8;fontColor=#555555;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="743.8" width="100" height="12" as="geometry" /></mxCell>
        <mxCell id="panelsc80" value="Grille centre (48, 17.5)&lt;br&gt;Ø1.5 holes, 3 mm hex pitch,&lt;br&gt;inside Ø22 (dashed circle)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#1A1A1A;spacing=0;" vertex="1" parent="1"><mxGeometry x="379.15" y="626" width="180" height="70" as="geometry" /></mxCell>
