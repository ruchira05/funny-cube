.0" y="666.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c182" value="6. SECTION C-C (z = 50, seen from front)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1290.0" y="578.0" width="420.0" height="22.0" as="geometry"/></mxCell><mxCell id="c183" value="" style="rounded=1;absoluteArcSize=1;arcSize=48;whiteSpace=wrap;html=1;fillColor=#CFCFCF;strokeColor=#222222;strokeWidth=2;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1300.0" y="640.0" width="246.0" height="234.0" as="geometry"/></mxCell><mxCell id="c184" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1312.0" y="652.0" width="222.0" height="210.0" as="geometry"/></mxCell><mxCell id="c185" value="DevKitC-1&lt;br&gt;29 × 13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;opacity=100;fontSize=8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1324.0" y="781.0" width="174.0" height="78.0" as="geometry"/></mxCell><mxCell id="c186" value="spk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1;opacity=100;fontSize=7;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1510.0" y="673.0" width="24.0" height="168.0" as="geometry"/></mxCell><mxCell id="c187" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="806.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c188" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="788.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c189" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="770.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c190" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="752.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c191" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="734.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c192" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="716.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c193" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF;strokeColor=#333;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1534.0" y="698.5" width="12.0" height="9.0" as="geometry"/></mxCell><mxCell id="c194" value="amp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;opacity=100;fontSize=7;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1324.0" y="652.0" width="106.8" height="18.0" as="geometry"/></mxCell><mxCell id="c195" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAD7AC;strokeColor=#B46504;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1312.0" y="679.0" width="9.6" height="87.0" as="geometry"/></mxCell><mxCell id="c196" value="LiPo 30 × 6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C9E4F6;strokeColor=#2D7BB6;strokeWidth=1;opacity=100;fontSize=7;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1324.0" y="739.0" width="180.0" height="36.0" as="geometry"/></mxCell><mxCell id="c197" value="TP4056" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F0D0;strokeColor=#7A9A3A;strokeWidth=1;opacity=100;fontSize=7;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1363.0" y="700.0" width="102.0" height="30.0" as="geometry"/></mxCell><mxCell id="c198" value="" style="html=1;strokeColor=#C0392B;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=oval;startFill=1;startSize=4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1316.8" y="724.0" as="sourcePoint"/><mxPoint x="1336.0" y="678.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c199" value="accelerometer (left wall)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=7;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1336.0" y="672.4" width="150.0" height="40.0" as="geometry"/></mxCell><mxCell id="c200" value="41" style="html=1;strokeColor=#555555;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300.0" y="900.0" as="sourcePoint"/><mxPoint x="1546.0" y="900.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c201" value="" style="html=1;strokeColor=#AAAAAA;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300.0" y="874.0" as="sourcePoint"/><mxPoint x="1300.0" y="903.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c202" value="" style="html=1;strokeColor=#AAAAAA;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1546.0" y="874.0" as="sourcePoint"/><mxPoint x="1546.0" y="903.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c203" value="39" style="html=1;strokeColor=#555555;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=4;endSize=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1562.0" y="874.0" as="sourcePoint"/><mxPoint x="1562.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c204" value="" style="html=1;strokeColor=#AAAAAA;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1546.0" y="874.0" as="sourcePoint"/><mxPoint x="1565.0" y="874.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c205" value="" style="html=1;strokeColor=#AAAAAA;fontSize=9;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1546.0" y="640.0" as="sourcePoint"/><mxPoint x="1565.0" y="640.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c206" value="7. PARTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="80.0" y="978.0" width="620.0" height="22.0" as="geometry"/></mxCell><mxCell id="c207" value="&lt;table border=1 cellpadding=3 style='border-collapse:collapse;font-size:10px'&gt;&lt;tr&gt;&lt;th&gt;Part&lt;/th&gt;&lt;th&gt;Size (mm)&lt;/th&gt;&lt;th&gt;Where&lt;/th&gt;&lt;th&gt;Position&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;OLED 1.3&quot;&lt;/td&gt;&lt;td&gt;35.4 × 33.5 × 4.5&lt;/td&gt;&lt;td&gt;Front&lt;/td&gt;&lt;td&gt;fills the face; window 31 × 16.5 at centre&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Touch strip&lt;/td&gt;&lt;td&gt;31 × 5.5 copper&lt;/td&gt;&lt;td&gt;Front, below window&lt;/td&gt;&lt;td&gt;behind a 1 mm wall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DevKitC-1&lt;/td&gt;&lt;td&gt;65 × 29 × 13&lt;/td&gt;&lt;td&gt;Floor&lt;/td&gt;&lt;td&gt;x 4–33, z 7.5–72.5, antenna at front&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;INMP441 mic&lt;/td&gt;&lt;td&gt;14 × 14&lt;/td&gt;&lt;td&gt;Top wall&lt;/td&gt;&lt;td&gt;hole Ø1.5 at z 19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MAX98357A&lt;/td&gt;&lt;td&gt;17.8 × 19.4 × 3&lt;/td&gt;&lt;td&gt;Top wall&lt;/td&gt;&lt;td&gt;z 40–59.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Speaker (thin)&lt;/td&gt;&lt;td&gt;Ø28 × 4&lt;/td&gt;&lt;td&gt;Right wall&lt;/td&gt;&lt;td&gt;centre z 50, y 19.5; foam ring&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MMA8452&lt;/td&gt;&lt;td&gt;14.5 × 20.5&lt;/td&gt;&lt;td&gt;Left wall&lt;/td&gt;&lt;td&gt;z 40–60.5, y 18–32.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LiPo BA0144&lt;/td&gt;&lt;td&gt;6 × 30 × 40 (+3), 800 mAh&lt;/td&gt;&lt;td&gt;Above board&lt;/td&gt;&lt;td&gt;z 22–65, 8.5 mm clear of antenna&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TP4056 MD0744&lt;/td&gt;&lt;td&gt;26 × 17 × 5&lt;/td&gt;&lt;td&gt;Above battery, back&lt;/td&gt;&lt;td&gt;USB-C → CHARGE slot in lid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Boost MD0745&lt;/td&gt;&lt;td&gt;22 × 11 × 3.6&lt;/td&gt;&lt;td&gt;Above battery&lt;/td&gt;&lt;td&gt;z 28–39; set to 5 V (A + B open)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;USB-C slots&lt;/td&gt;&lt;td&gt;26 × 8 + 11 × 7&lt;/td&gt;&lt;td&gt;Back lid&lt;/td&gt;&lt;td&gt;DevKit (flash) + charge, pocket 30 × 32.5 × 7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Screws&lt;/td&gt;&lt;td&gt;2× M2 × 6 CSK&lt;/td&gt;&lt;td&gt;Back lid&lt;/td&gt;&lt;td&gt;top corners + hook lip&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="620" height="300" as="geometry"/></mxCell><mxCell id="c208" value="8. FACE → MODE MAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="760.0" y="978.0" width="420.0" height="22.0" as="geometry"/></mxCell><mxCell id="c209" value="&lt;table border=1 cellpadding=3 style='border-collapse:collapse;font-size:10px'&gt;&lt;tr&gt;&lt;th&gt;Face down&lt;/th&gt;&lt;th&gt;Screen&lt;/th&gt;&lt;th&gt;Mode (suggested)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Bottom&lt;/td&gt;&lt;td&gt;landscape, mic up&lt;/td&gt;&lt;td&gt;A Key buddy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Left&lt;/td&gt;&lt;td&gt;portrait, speaker up&lt;/td&gt;&lt;td&gt;B Alarm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Top&lt;/td&gt;&lt;td&gt;landscape (flipped)&lt;/td&gt;&lt;td&gt;C Reminders&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Right&lt;/td&gt;&lt;td&gt;portrait, speaker on desk&lt;/td&gt;&lt;td&gt;D Focus / clock&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Back&lt;/td&gt;&lt;td&gt;faces up&lt;/td&gt;&lt;td&gt;Off (deep sleep)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="760" y="1010" width="420" height="220" as="geometry"/></mxCell><mxCell id="c210" value="9. NOTES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1640.0" y="108.0" width="540.0" height="22.0" as="geometry"/></mxCell><mxCell id="c211" value="&lt;b&gt;Body&lt;/b&gt;: 41 × 39 × 81 box, R4 edges, 2 mm walls. Shell (front + 4 sides) is one print; the back is a lid.&lt;br&gt;Depth: 2 wall + 4.5 OLED + 1 gap + 65 board + 1.5 floor + 7 cable pocket = 81 (74 without the pocket).&lt;br&gt;&lt;br&gt;&lt;b&gt;Changed from your sketch&lt;/b&gt;&lt;br&gt;• Speaker moved from the back to the right wall: on the 39 mm back it collided with the USB-C plug.&lt;br&gt;• Amp added (top wall, next to the speaker). Buzzer removed, as in the plan.&lt;br&gt;• Accelerometer on the left wall (rigid, flat). Update FACE_DIR_* in config.h for this mounting.&lt;br&gt;• Touch strip shrunk to 31 × 5.5 to fit below the window.&lt;br&gt;&lt;br&gt;&lt;b&gt;Battery (v2.1)&lt;/b&gt;&lt;br&gt;• LiPo BA0144 800 mAh, size assumed 603040 = 6 × 30 × 40 + 3 for its protection PCB (tronic.lk lists no size).&lt;br&gt;• Wiring: cell → TP4056 B+/B− · TP4056 OUT+/OUT− → boost IN · boost 5 V → DevKit 5V pin + amp VIN.&lt;br&gt;• Boost ships at 12 V: open pads A and B for 5 V and measure before connecting.&lt;br&gt;• Charge through the CHARGE port. The DevKit port is for flashing only: don't use both at once unless the DevKit has a diode on its 5 V input.&lt;br&gt;• Battery sits ≥ 8.5 mm behind the antenna end. Pad it with foam; never press or puncture the pouch.&lt;br&gt;&lt;br&gt;&lt;b&gt;Check before printing&lt;/b&gt;&lt;br&gt;1. The plan lists a 40 mm speaker (SP0043, ~20–24 mm deep). It does not fit a 39 mm tall box. This design uses a thin 28 mm × 4 mm speaker. Keeping the 40 mm one needs about 48 × 46 × 81.&lt;br&gt;2. The antenna sits 1 mm behind the OLED. Test WiFi signal (RSSI) on the breadboard with the OLED that close; if it drops a lot, add a 5 mm gap (box becomes 86 long).&lt;br&gt;3. USB-C centre assumed 11.5 mm above the board's lowest point (pins down). Measure.&lt;br&gt;4. OLED glass assumed centred on its module. Measure the glass offset.&lt;br&gt;5. Right-angle USB-C cable, plug head ≤ 6.5 mm thick.&lt;br&gt;6. Wires soldered to the pins; no Dupont plugs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Print&lt;/b&gt;: shell front-face down, lid flat. PLA/PETG, 0.2 mm layers, +0.2 mm clearance, 100% infill at the 1 mm touch wall." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1640" y="140" width="540" height="760" as="geometry"/></mxCell><mxCell id="c212" value="KEY CUBE ENCLOSURE  ·  v2.1 compact box 41 × 39 × 81 + battery  ·  mm  ·  1 mm = 6 px" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=18;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="80.0" y="30.0" width="1500.0" height="34.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>