                <mxCell id="c214" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" value="&lt;table border=1 cellpadding=3 style=&#39;border-collapse:collapse;font-size:10px&#39;&gt;&lt;tr&gt;&lt;th&gt;Part&lt;/th&gt;&lt;th&gt;Size (mm)&lt;/th&gt;&lt;th&gt;Position (x, y, z)&lt;/th&gt;&lt;th&gt;Face&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;OLED 1.3&quot; module&lt;/td&gt;&lt;td&gt;35.4 × 33.5 × 4.5&lt;/td&gt;&lt;td&gt;centre 38.5, 50.75&lt;/td&gt;&lt;td&gt;Front&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;OLED window&lt;/td&gt;&lt;td&gt;31 × 16.5&lt;/td&gt;&lt;td&gt;centre 38.5, 50.75&lt;/td&gt;&lt;td&gt;Front&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mic INMP441&lt;/td&gt;&lt;td&gt;14 × 14&lt;/td&gt;&lt;td&gt;hole Ø1.5 at 11.5, 50.75&lt;/td&gt;&lt;td&gt;Front&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Buzzer&lt;/td&gt;&lt;td&gt;Ø12 × 8.5&lt;/td&gt;&lt;td&gt;hole Ø2.5 at 65.6, 50.75&lt;/td&gt;&lt;td&gt;Front&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Touch strip&lt;/td&gt;&lt;td&gt;50 × 10&lt;/td&gt;&lt;td&gt;x 13.5–63.5, y 20–30&lt;/td&gt;&lt;td&gt;Front, inside&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MMA8452 GY-45&lt;/td&gt;&lt;td&gt;14.5 × 20.5&lt;/td&gt;&lt;td&gt;centre 38.5, 50.75, z 9.8&lt;/td&gt;&lt;td&gt;Behind OLED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DevKitC-1&lt;/td&gt;&lt;td&gt;65 × 29 × 13&lt;/td&gt;&lt;td&gt;x 24–53, y 3.5–16.5, z 3.5–68.5&lt;/td&gt;&lt;td&gt;Floor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;USB-C slot&lt;/td&gt;&lt;td&gt;26 × 8&lt;/td&gt;&lt;td&gt;centre 38.5, 15&lt;/td&gt;&lt;td&gt;Back&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Cable pocket&lt;/td&gt;&lt;td&gt;30 × 24 × 7&lt;/td&gt;&lt;td&gt;x 23.5–53.5, y 0–24&lt;/td&gt;&lt;td&gt;Back&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Speaker (thin)&lt;/td&gt;&lt;td&gt;Ø28 × 4, cup Ø34&lt;/td&gt;&lt;td&gt;centre z 42, y 49&lt;/td&gt;&lt;td&gt;Right&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MAX98357A&lt;/td&gt;&lt;td&gt;17.8 × 19.4 × 3&lt;/td&gt;&lt;td&gt;z 14–31.8, y 4–23.4&lt;/td&gt;&lt;td&gt;Right, inside&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Screws&lt;/td&gt;&lt;td&gt;4× M2 × 8 CSK&lt;/td&gt;&lt;td&gt;7 from edges&lt;/td&gt;&lt;td&gt;Back corners&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="330" width="440" x="1200" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="c215" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=9;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" value="x from left, y from bottom (front view), z from the front face" vertex="1">
                    <mxGeometry height="30" width="440" x="1200" y="1080" as="geometry"/>
                </mxCell>
                <mxCell id="c216" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" value="7. NOTES" vertex="1">
                    <mxGeometry height="22" width="520" x="1700" y="108" as="geometry"/>
                </mxCell>
                <mxCell id="c217" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=4;" value="&lt;b&gt;Body&lt;/b&gt;: 77 × 77 × 77 cube, R6 edges, 2 mm walls, rounded minimal.&lt;br&gt;Depth: 2 wall + 1.5 gap + 65 board + 1.5 floor + 7 cable pocket = 77. Without the pocket 72 fits, but the cube could not rest on its back with the cable plugged in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Faces&lt;/b&gt;: Front = OLED, touch strip, mic, buzzer. Back = lid, USB-C, 4× M2. Right = speaker grille (up in Key-buddy mode). Left, top, bottom = plain and flat, so all 5 resting faces stand steady.&lt;br&gt;&lt;br&gt;&lt;b&gt;Check before printing&lt;/b&gt;&lt;br&gt;1. Header pins point down (8.3 mm), so the USB-C centre is ~11.5 mm above the board&#39;s lowest point (y = 15). Measure yours.&lt;br&gt;2. USB-C port spacing unknown: one 26 × 8 slot exposes both ports.&lt;br&gt;3. OLED glass assumed centred on its module. Measure the glass offset.&lt;br&gt;4. Speaker = SparkFun thin 28 mm 4 Ω (~4 mm). The louder 11 mm one needs a 7 mm deeper cup.&lt;br&gt;5. Right-angle USB-C cable, plug head ≤ 6.5 mm thick, ≤ 28 mm wide.&lt;br&gt;6. Wires soldered straight to the pins. Dupont plugs add ~12 mm and won&#39;t fit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Assembly&lt;/b&gt;: OLED into window (clip ledges) → copper strip on thin wall → mic with foam gasket → buzzer → accelerometer bracket → speaker sealed in cup → amp on right wall → board slides in from the back onto its cradle → lid with 4× M2 × 8 countersunk into heat-set inserts (or Ø1.6 pilot holes).&lt;br&gt;&lt;br&gt;&lt;b&gt;Print&lt;/b&gt;: shell (front + 4 sides) front-face down; lid flat. PLA or PETG, 0.2 mm layers, 3 perimeters, +0.2 mm clearance on pockets, 100% infill at the 1 mm touch wall." vertex="1">
                    <mxGeometry height="700" width="520" x="1700" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="c218" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=18;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" value="KEY CUBE ENCLOSURE  ·  2D design v1  ·  all dimensions in mm  ·  scale 1 mm = 5 px" vertex="1">
                    <mxGeometry height="34" width="1500" x="80" y="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
