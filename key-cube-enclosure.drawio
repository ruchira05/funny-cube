                <mxCell id="c213" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;opacity=100;fontSize=13;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" value="6. PARTS AND POSITIONS" vertex="1">
