"/><mxPoint x="2224.0" y="1652.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c365" value="Ø2.6" style="html=1;strokeColor=#555555;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=5;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2312.0" y="1538.8" as="sourcePoint"/><mxPoint x="2312.0" y="1497.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c366" value="" style="html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2296.0" y="1538.8" as="sourcePoint"/><mxPoint x="2316.0" y="1538.8" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c367" value="" style="html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2296.0" y="1497.2" as="sourcePoint"/><mxPoint x="2316.0" y="1497.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c368" value="Ø5" style="html=1;strokeColor=#555555;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=block;endArrow=block;startFill=1;endFill=1;startSize=5;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2350.0" y="1558.0" as="sourcePoint"/><mxPoint x="2350.0" y="1478.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c369" value="" style="html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2296.0" y="1558.0" as="sourcePoint"/><mxPoint x="2354.0" y="1558.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c370" value="" style="html=1;strokeColor=#AAAAAA;strokeWidth=1;fontSize=10;labelBackgroundColor=#FFFFFF;rounded=0;startArrow=none;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2296.0" y="1478.0" as="sourcePoint"/><mxPoint x="2354.0" y="1478.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c371" value="• wall 2 · shoulder 1.9 (glass 1.8 + 0.1) · PCB 1.6 · peg tip 1.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1966.0" y="1695.0" width="568.0" height="20.0" as="geometry"/></mxCell><mxCell id="c372" value="  press the OLED on, touch each tip with the iron (~200 °C) until it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1966.0" y="1717.0" width="568.0" height="20.0" as="geometry"/></mxCell><mxCell id="c373" value="  mushrooms over the hole (red dashed). Or: a drop of CA glue per tip." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1966.0" y="1739.0" width="568.0" height="20.0" as="geometry"/></mxCell><mxCell id="c374" value="✔ glass sits 0.1 mm behind the wall: positioned, never squeezed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#2E7D32;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="1966.0" y="1773.0" width="568.0" height="20.0" as="geometry"/></mxCell><mxCell id="c375" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;strokeWidth=1.5;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="1860.0" width="600.0" height="540.0" as="geometry"/></mxCell><mxCell id="c376" value="FASTENER KIT &amp;amp; NOTES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=16;fontColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="76.0" y="1872.0" width="568.0" height="24.0" as="geometry"/></mxCell><mxCell id="c377" value="Buy&lt;br&gt;• 2× M2 heat-set inserts (OD 3.2, length 3)&lt;br&gt;• 2× M2×6 countersunk machine screws (lid)&lt;br&gt;• 2× M2×5 pan-head self-tapping (accelerometer)&lt;br&gt;• hot glue or CA gel, double-sided foam tape,&lt;br&gt;   copper tape, thin foam sheet (mic gasket)&lt;br&gt;• soldering iron for heat-staking the OLED pegs&lt;br&gt;&lt;br&gt;Rules used for every bracket&lt;br&gt;• pockets = part outline + 0.6 mm&lt;br&gt;• screw pads Ø5, pilot hole Ø1.7 for M2 self-tapping&lt;br&gt;• nothing is screwed through the front face&lt;br&gt;• glue on the PCB edge / pocket rim, never on chips&lt;br&gt;&lt;br&gt;Applied in cubev2.blend&lt;br&gt;• accelerometer and amp both on the top wall&lt;br&gt;• lid screws moved in to the flat part of the lid&lt;br&gt;• inserts sit in solid corner blocks&lt;br&gt;• OLED sits on 4 heat-staked pegs (no bumps)&lt;br&gt;• touch strip narrows to 24 mm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=3;spacingTop=1;" vertex="1" parent="1"><mxGeometry x="76.0" y="1910.0" width="568.0" height="470.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>